_TIER_ORDER = ('FATAL', 'PERSIST', 'TUNING', 'COMMS')
_TIER_COLOR = {'FATAL': _red, 'PERSIST': _yellow, 'TUNING': _cyan, 'COMMS': _grey}


def _fmt_value(val, reason, as_hex):
    if val is None:
        return _red('N/A') if reason in ('timeout', 'ok') else _red(reason)
    if as_hex:
        h = f'0x{val & 0xFFFFFFFF:X}' if val >= 0 else f'{val}'
        return f'{val} ({h})'
    return str(val)


def _obj_label(index, sub):
    return f'0x{index:04X}:{sub:02X}'


def _rjust(text, width):
    """Right-justify to `width` visible columns, ignoring embedded ANSI codes."""
    pad = width - len(_strip(text))
    return (' ' * pad + text) if pad > 0 else text


def _applies(index, node):
    """Homing objects are steer-only on the AMR chassis."""
    if index in _HOMING_INDEXES and node not in STEER_NODES:
        return False
    return True


def read_amr(iface, nodes, as_hex):
    print(_bold(f'\n══ AMR chassis — {iface} — nodes {", ".join(map(str, nodes))} ══'))
    try:
        sock = open_can_socket(iface)
    except OSError as exc:
        print(_red(f'  cannot open {iface}: {exc}'))
        return
    with sock:
        name_w = max(len(o[4]) for o in AMR_OBJECTS)
        col_w = 14 if as_hex else 9
        header = f'  {"OBJECT":<11} {"NAME":<{name_w}} {"TYPE":<4} ' + \
                 ' '.join(_rjust('n' + str(n), col_w) for n in nodes)
        for tier in _TIER_ORDER:
            rows = [o for o in AMR_OBJECTS if o[3] == tier]
            if not rows:
                continue
            print('\n' + _TIER_COLOR[tier](_bold(f'  ── {tier} ──')))
            print(_bold(header))
            for index, sub, typ, _t, name in rows:
                signed = _TYPE[typ][1]
                cells = []
                for n in nodes:
                    if not _applies(index, n):
                        cells.append(_rjust(_grey('—'), col_w))
                        continue
                    val, reason = sdo_read(sock, n, index, sub, signed)
                    cells.append(_rjust(_fmt_value(val, reason, as_hex), col_w))
                print(f'  {_obj_label(index, sub):<11} {name:<{name_w}} {typ:<4} ' + ' '.join(cells))


def read_lift(iface, node, as_hex):
    print(_bold(f'\n══ Liftkit — {iface} — node {node} ══'))
    try:
        sock = open_can_socket(iface)
    except OSError as exc:
        print(_red(f'  cannot open {iface}: {exc}'))
        return
    with sock:
        name_w = max(len(o[4]) for o in LIFT_OBJECTS)
        for tier in _TIER_ORDER:
            rows = [o for o in LIFT_OBJECTS if o[3] == tier]
            if not rows:
                continue
            print('\n' + _TIER_COLOR[tier](_bold(f'  ── {tier} ──')))
            print(_bold(f'  {"OBJECT":<11} {"NAME":<{name_w}} {"TYPE":<4} {"VALUE":>18}'))
            for index, sub, typ, _t, name in rows:
                val, reason = sdo_read(sock, node, index, sub, _TYPE[typ][1])
                cell = _rjust(_fmt_value(val, reason, as_hex), 18)
                print(f'  {_obj_label(index, sub):<11} {name:<{name_w}} {typ:<4} {cell}')


def _strip(s):
    """Length of s without ANSI colour codes (for width-correct right-align)."""
    out, i = [], 0
    while i < len(s):
        if s[i] == '\033':
            while i < len(s) and s[i] != 'm':
                i += 1
            i += 1
            continue
        out.append(s[i])
        i += 1
    return ''.join(out)


def main():
    ap = argparse.ArgumentParser(description='Read configurable OD values from AMR + liftkit drives.')
    ap.add_argument('--amr-iface', default=DEFAULT_AMR_IFACE, help='AMR CAN interface (default can0)')
    ap.add_argument('--lift-iface', default=DEFAULT_LIFT_IFACE, help='liftkit CAN interface (default can1)')
    ap.add_argument('--nodes', type=int, nargs='+', default=list(AMR_NODES),
                    help='AMR node ids to read (default 1-6)')
    ap.add_argument('--amr-only', action='store_true')
    ap.add_argument('--lift-only', action='store_true')
    ap.add_argument('--hex', action='store_true', help='also show values in hex')
    args = ap.parse_args()

    print(_bold('═' * 72))
    print(_bold('  Configurable-OD Value Reader'))
    print(_grey('  Pre-flight only — run before the ros2_canopen stack starts.'))
    print(_bold('═' * 72))

    if not args.lift_only:
        read_amr(args.amr_iface, tuple(args.nodes), args.hex)
    if not args.amr_only:
        read_lift(args.lift_iface, LIFT_NODE, args.hex)

    print(_grey('\n  N/A = no SDO response (node down, or object absent on this drive).'))
    print(_grey('  —   = not applicable (homing objects are steer-only on the AMR).'))


if __name__ == '__main__':
    main()
