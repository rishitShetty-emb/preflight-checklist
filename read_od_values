def _green(s):  return f'\033[32m{s}\033[0m' if _IS_TTY else s
def _yellow(s): return f'\033[33m{s}\033[0m' if _IS_TTY else s
def _red(s):    return f'\033[31m{s}\033[0m' if _IS_TTY else s
def _grey(s):   return f'\033[90m{s}\033[0m' if _IS_TTY else s


# ── Type table: width (bytes) + signedness for display ───────────────────────────
_TYPE = {
