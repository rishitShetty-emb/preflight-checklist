# (1/3/5) never home, so these are shown as "—" there rather than read.
_HOMING_INDEXES = (0x6098, 0x6099, 0x609A)


def open_can_socket(iface):
    sock = socket.socket(socket.AF_CAN, socket.SOCK_RAW, socket.CAN_RAW)
    sock.bind((iface,))
    sock.settimeout(0.5)
    return sock


def _drain(sock):
    """Discard buffered/stale frames so a late response to a previous request (or
    another SDO client) can't be mis-attributed to the next read."""
    sock.settimeout(0.0)
    try:
        while True:
            sock.recv(FRAME_SZ)
    except (BlockingIOError, socket.timeout, OSError):
        pass
    finally:
        sock.settimeout(0.5)


def _resp_matches(rdata, index, subindex):
    """Server echoes index (bytes 1-2 LE) + subindex (byte 3); match on them so a
    stale/concurrent 0x580+id frame can't land on the wrong parameter."""
    return struct.unpack_from('<H', rdata, 1)[0] == index and rdata[3] == subindex


def sdo_read(sock, node_id, index, subindex, signed, timeout=0.5):
    """Expedited SDO upload. Returns (value:int, 'ok') or (None, reason).
    Width comes from the drive's response cmd byte; signedness from the caller."""
    cob_req = 0x600 + node_id
    cob_resp = 0x580 + node_id
    _drain(sock)
    req = struct.pack('<BHBB4x', 0x40, index, subindex, 0)
    try:
        sock.send(struct.pack('=IB3x8s', cob_req, 8, req))
    except OSError as exc:
        return None, f'send:{exc.errno}'
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            raw = sock.recv(FRAME_SZ)
        except socket.timeout:
            continue
        rid, _dlc, rdata = struct.unpack(CAN_FRAME_FMT, raw)
        if (rid & 0x1FFFFFFF) != cob_resp:
            continue
        if not _resp_matches(rdata, index, subindex):
            continue
        if rdata[0] == 0x80:
            abort = struct.unpack_from('<I', rdata, 4)[0]
            return None, f'abort 0x{abort:08X}'
        cmd = rdata[0]
        n_bytes = 4 - ((cmd >> 2) & 0x03) if (cmd & 0x02) else 4
        value = int.from_bytes(rdata[4:4 + n_bytes], 'little', signed=signed)
        return value, 'ok'
    return None, 'timeout'


