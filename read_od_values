import socket
import struct
import sys
import time

# ── CAN frame plumbing (raw SocketCAN, expedited SDO) ────────────────────────────
CAN_FRAME_FMT = '=IB3x8s'
FRAME_SZ = struct.calcsize(CAN_FRAME_FMT)

