def _rtde_send(sock, msg_type, payload=b''):
    sock.sendall(struct.pack('>HB', 3 + len(payload), msg_type) + payload)


def _rtde_recv(sock, expect_type=None, timeout=1.0):
    """Read one RTDE frame, optionally skipping until expect_type is seen."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        sock.settimeout(max(0.01, deadline - time.monotonic()))
        try:
            hdr = b''
            while len(hdr) < 3:
                chunk = sock.recv(3 - len(hdr))
                if not chunk:
                    return None, None
                hdr += chunk
            size, mtype = struct.unpack('>HB', hdr)
            body = b''
            remaining = size - 3
            while remaining > 0:
                chunk = sock.recv(remaining)
                if not chunk:
                    return None, None
                body += chunk
                remaining -= len(chunk)
            if expect_type is None or mtype == expect_type:
                return mtype, body
            # unknown / unwanted frame — keep reading
        except socket.timeout:
            break
    return None, None


def check_ur_rtde_timing(ur_ip):
    """
    Single RTDE session that measures timing (latency, frequency, sync) and
    captures one DATA_PACKAGE snapshot of robot state variables.
    """
    print(f"\n  [UR RTDE — {ur_ip}:{_RTDE_PORT} — {_UR_TIMING_S:.0f} s @ {_UR_TARGET_HZ:.0f} Hz]")

    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(3.0)
        s.connect((ur_ip, _RTDE_PORT))
    except Exception as exc:
        print(f"  [warn] RTDE connect failed: {exc}")
        return

    rtt_samples, intervals, sync_samples = [], [], []
    payload_var_names  = _UR_PAYLOAD_VARS.split(',')
    payload_type_codes = []
    snapshot_raw       = None

    try:
        # ── Protocol negotiation ──────────────────────────────────────────────
        _rtde_send(s, _RTDE_REQUEST_PROTOCOL, struct.pack('>H', _RTDE_PROTO_VER))
        mtype, resp = _rtde_recv(s, expect_type=_RTDE_REQUEST_PROTOCOL)
        if not resp or resp[0] != 1:
            print(f"  [warn] RTDE protocol negotiation failed")
            return

        # ── Latency: RTT using REQUEST_PROTOCOL ping (stateless, no recipe change) ──
        freq_bytes = struct.pack('>d', _UR_TARGET_HZ)
        proto_ping = struct.pack('>H', _RTDE_PROTO_VER)
        for _ in range(20):
            t0 = time.monotonic_ns()
            _rtde_send(s, _RTDE_REQUEST_PROTOCOL, proto_ping)
            mtype, resp = _rtde_recv(s, expect_type=_RTDE_REQUEST_PROTOCOL, timeout=0.5)
            if mtype == _RTDE_REQUEST_PROTOCOL:
                rtt_samples.append((time.monotonic_ns() - t0) / 1_000)

        # ── SETUP_OUTPUTS with full payload variable list ─────────────────────
        _rtde_send(s, _RTDE_SETUP_OUTPUTS, freq_bytes + _UR_PAYLOAD_VARS.encode())
        mtype, resp = _rtde_recv(s, expect_type=_RTDE_SETUP_OUTPUTS, timeout=1.0)
        if mtype != _RTDE_SETUP_OUTPUTS or not resp:
            print(f"  [warn] RTDE output setup failed")
            return
        # Response body: [recipe_id: 1B][comma-separated ASCII type names]
        # e.g. b'\x01DOUBLE,VECTOR6D,VECTOR6D,INT32,INT32,DOUBLE,DOUBLE,DOUBLE'
        if len(resp) > 1:
            payload_type_codes = resp[1:].decode('ascii', errors='replace').split(',')
        if len(payload_type_codes) != len(payload_var_names):
            payload_type_codes = []
        # Retry without NOT_FOUND variables
        if 'NOT_FOUND' in payload_type_codes:
            good_pairs = [(nm, tn) for nm, tn in zip(payload_var_names, payload_type_codes)
                          if tn != 'NOT_FOUND']
            if good_pairs:
                good_names = [p[0] for p in good_pairs]
                _rtde_send(s, _RTDE_SETUP_OUTPUTS, freq_bytes + ','.join(good_names).encode())
                mtype, resp = _rtde_recv(s, expect_type=_RTDE_SETUP_OUTPUTS, timeout=1.0)
                if mtype == _RTDE_SETUP_OUTPUTS and len(resp) > 1:
                    payload_type_codes = resp[1:].decode('ascii', errors='replace').split(',')
                    payload_var_names  = good_names

        # ── Input setup for sync measurement ─────────────────────────────────
        _rtde_send(s, _RTDE_SETUP_INPUTS, b'speed_slider_fraction')
        mtype, resp = _rtde_recv(s, expect_type=_RTDE_SETUP_INPUTS, timeout=1.0)
        input_rid = resp[0] if (mtype == _RTDE_SETUP_INPUTS and resp) else None

        # ── Start streaming ───────────────────────────────────────────────────
        _rtde_send(s, _RTDE_START)
        mtype, resp = _rtde_recv(s, expect_type=_RTDE_START, timeout=1.0)
        if not resp or resp[0] != 1:
            print(f"  [warn] RTDE start failed")
            return

        # ── Sync: cmd→feedback round-trip ────────────────────────────────────
        if input_rid is not None:
            for _ in range(_UR_SYNC_SAMPLES):
                mtype, _ = _rtde_recv(s, expect_type=_RTDE_DATA_PACKAGE, timeout=0.05)
                if mtype != _RTDE_DATA_PACKAGE:
                    continue
                t_cmd = time.monotonic_ns()
                _rtde_send(s, _RTDE_DATA_PACKAGE,
                           struct.pack('>Bd', input_rid, 1.0))
                mtype, _ = _rtde_recv(s, expect_type=_RTDE_DATA_PACKAGE, timeout=0.05)
                if mtype == _RTDE_DATA_PACKAGE:
                    sync_samples.append((time.monotonic_ns() - t_cmd) / 1_000)

        # ── Frequency + snapshot ─────────────────────────────────────────────
        last_t   = time.monotonic_ns()
        deadline = time.monotonic() + _UR_TIMING_S
        while time.monotonic() < deadline:
            mtype, body = _rtde_recv(s, expect_type=_RTDE_DATA_PACKAGE, timeout=0.01)
            if mtype == _RTDE_DATA_PACKAGE:
                now = time.monotonic_ns()
                intervals.append((now - last_t) / 1_000)
                last_t = now
                if snapshot_raw is None:
                    snapshot_raw = body   # save first packet for payload display

        _rtde_send(s, _RTDE_PAUSE)
        _rtde_recv(s, expect_type=_RTDE_PAUSE, timeout=0.5)

    finally:
        s.close()

    # ── Timing results ────────────────────────────────────────────────────────
    avg = lambda lst: sum(lst) / len(lst) if lst else 0.0

    avg_interval_us = avg(intervals)
    freq_hz         = 1e6 / avg_interval_us if avg_interval_us else 0.0
    lat_avg         = avg(rtt_samples)
    lat_min         = min(rtt_samples) if rtt_samples else 0.0
    lat_max         = max(rtt_samples) if rtt_samples else 0.0
    sync_avg        = avg(sync_samples)
    sync_min        = min(sync_samples) if sync_samples else 0.0

    col_d = 12
    col_a = 44
    print(f"\n  {'metric':<18}  {'designed':>{col_d}}  actual")
    print(f"  {'-'*18}  {'-'*col_d}  {'-'*col_a}")
    print(f"  {'frequency_hz':<18}  {f'{_UR_TARGET_HZ:.0f} Hz':>{col_d}}  {freq_hz:.2f} Hz")
    print(f"  {'latency_us':<18}  {f'<{_UR_DESIGNED_LAT_US/1000:.0f} ms':>{col_d}}  "
          f"{lat_avg:.1f} µs avg  (min {lat_min:.1f}  max {lat_max:.1f})")
    cycle_ms  = 1000.0 / _UR_TARGET_HZ
    sync_str  = f'{sync_avg:.1f} µs' if sync_samples else 'N/A (input setup failed)'
    print(f"  {'sync_us':<18}  {f'<1 cycle ({cycle_ms:.0f} ms)':>{col_d}}  {sync_str}")

    # ── Payload snapshot ──────────────────────────────────────────────────────
    print(f"\n  [UR RTDE payload snapshot]")
    col = 24
    print(f"  {'variable':<{col}}  value")
    print(f"  {'-'*col}  {'-'*55}")

    decoded = {}
    if snapshot_raw and payload_type_codes:
        offset = 1   # skip recipe_id byte
        for name, tn in zip(payload_var_names, payload_type_codes):
            size = _RTDE_TYPE_SIZES.get(tn, 0)
            if size == 0:
                decoded[name] = None
                continue
            chunk = snapshot_raw[offset:offset + size]
            if len(chunk) < size:
                decoded[name] = None
            elif tn == 'DOUBLE':
                decoded[name] = struct.unpack('>d', chunk)[0]
            elif tn == 'FLOAT':
                decoded[name] = struct.unpack('>f', chunk)[0]
            elif tn == 'INT32':
                decoded[name] = struct.unpack('>i', chunk)[0]
            elif tn == 'UINT32':
                decoded[name] = struct.unpack('>I', chunk)[0]
            elif tn == 'INT16':
                decoded[name] = struct.unpack('>h', chunk)[0]
            elif tn == 'UINT16':
                decoded[name] = struct.unpack('>H', chunk)[0]
            elif tn in ('BOOL', 'UINT8'):
                decoded[name] = chunk[0]
            elif tn == 'VECTOR6D':
                decoded[name] = struct.unpack('>6d', chunk)
            elif tn == 'VECTOR3D':
                decoded[name] = struct.unpack('>3d', chunk)
            elif tn == 'VECTOR6INT32':
                decoded[name] = struct.unpack('>6i', chunk)
            else:
                decoded[name] = chunk.hex()
            offset += size

    for name in _UR_PAYLOAD_VARS.split(','):
        v = decoded.get(name)
        if v is None:
            print(f"  {name:<{col}}  N/A")
        elif name == 'timestamp':
            print(f"  {name:<{col}}  {v:.3f} s")
        elif name == 'actual_q':
            deg = [math.degrees(x) for x in v]
            print(f"  {name:<{col}}  [{', '.join(f'{x:.2f}' for x in deg)}] deg")
        elif name == 'actual_TCP_pose':
            pos = [v[i] * 1000 for i in range(3)]
            rot = [math.degrees(v[i]) for i in range(3, 6)]
            print(f"  {name:<{col}}  xyz [{', '.join(f'{x:.1f}' for x in pos)}] mm"
                  f"  rot [{', '.join(f'{x:.2f}' for x in rot)}] deg")
        elif name == 'robot_mode':
            print(f"  {name:<{col}}  {v} ({_UR_ROBOT_MODES.get(v, '?')})")
        elif name == 'safety_mode':
            print(f"  {name:<{col}}  {v} ({_UR_SAFETY_MODES.get(v, '?')})")
        elif name == 'speed_scaling':
            print(f"  {name:<{col}}  {v:.3f}")
        elif name == 'actual_robot_voltage':
            print(f"  {name:<{col}}  {v:.1f} V")
        elif name == 'actual_robot_current':
            print(f"  {name:<{col}}  {v:.2f} A")
        else:
            print(f"  {name:<{col}}  {v}")


