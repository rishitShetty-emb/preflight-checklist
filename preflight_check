def check_liftkit(skip_tool):
    print("\n[LIFTKIT (can1)]")
    iface = 'can1'
    nodes = {7: 'Lift motor'} if skip_tool else {7: 'Lift motor', 8: 'Tool'}

    up = can_interface_up(iface)
    result(up, "Interface UP")
    if not up:
        for nid, label in nodes.items():
            result(False, f"{label:<11} node {nid}  statusword — skipped (interface down)")
        return

    try:
        sock = _open_can_socket(iface)
    except Exception as exc:
        for nid, label in nodes.items():
            result(False, f"{label:<11} node {nid}  statusword — socket error: {exc}")
        return

    try:
        for nid in nodes:
            send_nmt(sock, NMT_PRE_OP, nid)
        time.sleep(0.1)

        check_statusword_sock(sock, 7, 'Lift motor')
        if not skip_tool:
            check_tool_state(sock, nid=8)

        # PID readout — motor node 7 only (tool node 8 is not a CiA 402 drive)
        check_motor_pids(sock, [n for n in nodes if n == 7],
                         node_labels={7: 'lift_motor'})

        tpdo1 = {nid: LIFTKIT_TPDO1[nid] for nid in nodes if nid in LIFTKIT_TPDO1}
        tpdo2 = {nid: LIFTKIT_TPDO2[nid] for nid in nodes if nid in LIFTKIT_TPDO2}
        run_can_timing_test(sock, 'can1', list(nodes.keys()), tpdo1_map=tpdo1, tpdo2_map=tpdo2)
    finally:
        sock.close()

