def _open_can_socket(iface):
    sock = socket.socket(socket.AF_CAN, socket.SOCK_RAW, socket.CAN_RAW)
    sock.bind((iface,))
    sock.settimeout(0.05)
    return sock

def send_nmt(sock, command, node_id=0):
    """Send NMT command. node_id=0 broadcasts to all nodes on the bus."""
    payload = struct.pack('BB6x', command, node_id)
    sock.send(struct.pack('=IB3x8s', 0x000, 2, payload))

def sdo_read_u16(sock, node_id, index, subindex, timeout=0.5):
    """CANopen expedited SDO upload. Returns uint16 or None on error/timeout."""
    cob_req = 0x600 + node_id
    data = struct.pack('<BHBB4x', 0x40, index, subindex, 0)
    try:
        sock.send(struct.pack('=IB3x8s', cob_req, 8, data))
    except Exception:
        return None
    cob_resp = 0x580 + node_id
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            raw = sock.recv(FRAME_SZ)
            rid, _dlc, rdata = struct.unpack('=IB3x8s', raw)
            if (rid & 0x1FFFFFFF) != cob_resp:
                continue
            if rdata[0] == 0x80:   # SDO abort
                return None
            return struct.unpack_from('<H', rdata, 4)[0]
        except socket.timeout:
            pass
    return None

def _sdo_write(sock, node_id, cmd, index, subindex, data_bytes, timeout=0.5):
    """Base SDO expedited download. cmd encodes the data size (0x2F/0x2B/0x23)."""
    cob_req  = 0x600 + node_id
    cob_resp = 0x580 + node_id
    payload  = struct.pack('=IB3x8s', cob_req, 8,
                           struct.pack('<BHB', cmd, index, subindex) + data_bytes)
    try:
        sock.send(payload)
    except Exception:
        return False
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            raw = sock.recv(FRAME_SZ)
            rid, _dlc, rdata = struct.unpack('=IB3x8s', raw)
            if (rid & 0x1FFFFFFF) != cob_resp:
                continue
            if rdata[0] == 0x80:   # SDO abort
                return False
            if rdata[0] == 0x60:   # download acknowledge
                return True
        except socket.timeout:
            pass
    return False


def sdo_write_i8(sock, node_id, index, subindex, value, timeout=0.5):
    """SDO download, INT8 — cmd 0x2F (1 data byte)."""
    return _sdo_write(sock, node_id, 0x2F, index, subindex,
                      struct.pack('<b3x', value), timeout)


def sdo_write_u16(sock, node_id, index, subindex, value, timeout=0.5):
    """SDO download, UINT16 — cmd 0x2B (2 data bytes). Use for controlword 0x6040."""
    return _sdo_write(sock, node_id, 0x2B, index, subindex,
                      struct.pack('<H2x', value & 0xFFFF), timeout)


def sdo_write_u8(sock, node_id, index, subindex, value, timeout=0.5):
    """SDO download, UINT8 — cmd 0x2F (1 data byte). Use for TPDO mapping count, tx type."""
    return _sdo_write(sock, node_id, 0x2F, index, subindex,
                      struct.pack('<B3x', value & 0xFF), timeout)


def sdo_write_u32(sock, node_id, index, subindex, value, timeout=0.5):
    """SDO download, UINT32 — cmd 0x23 (4 data bytes). Use for TPDO COB-ID / mapping entries."""
    return _sdo_write(sock, node_id, 0x23, index, subindex,
                      struct.pack('<I', value & 0xFFFFFFFF), timeout)


def sdo_write_i32(sock, node_id, index, subindex, value, timeout=0.5):
    """SDO download, INT32 — cmd 0x23 (4 data bytes). Use for target position 0x607A."""
    return _sdo_write(sock, node_id, 0x23, index, subindex,
                      struct.pack('<i', value), timeout)


def sdo_read_i32(sock, node_id, index, subindex, timeout=0.5):
    """CANopen expedited SDO upload for int32. Returns int32 or None on error/timeout."""
    cob_req = 0x600 + node_id
    data = struct.pack('<BHBB4x', 0x40, index, subindex, 0)
    try:
        sock.send(struct.pack('=IB3x8s', cob_req, 8, data))
    except Exception:
        return None
    cob_resp = 0x580 + node_id
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            raw = sock.recv(FRAME_SZ)
            rid, _dlc, rdata = struct.unpack('=IB3x8s', raw)
            if (rid & 0x1FFFFFFF) != cob_resp:
                continue
            if rdata[0] == 0x80:
                return None
            return struct.unpack_from('<i', rdata, 4)[0]
        except socket.timeout:
            pass
    return None

def sdo_read_raw(sock, node_id, index, subindex, timeout=0.5):
    """Generic SDO upload — returns integer value for any object size, or None."""
    cob_req  = 0x600 + node_id
    cob_resp = 0x580 + node_id
    req = struct.pack('<BHBB4x', 0x40, index, subindex, 0)
    try:
        sock.send(struct.pack('=IB3x8s', cob_req, 8, req))
    except Exception:
        return None
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            raw = sock.recv(FRAME_SZ)
            rid, _dlc, rdata = struct.unpack('=IB3x8s', raw)
            if (rid & 0x1FFFFFFF) != cob_resp:
                continue
            if rdata[0] == 0x80:
                return None
            # CiA 301 expedited upload response: cmd byte encodes number of bytes
            cmd = rdata[0]
            n_bytes = 4 - ((cmd >> 2) & 0x03) if (cmd & 0x02) else 4
            return int.from_bytes(rdata[4:4 + n_bytes], 'little')
        except socket.timeout:
            pass
    return None


def check_statusword_sock(sock, node_id, label):
    """Read statusword via open socket, check fault bit."""
    sw = sdo_read_u16(sock, node_id, index=0x6041, subindex=0)
    if sw is None:
        result(False, f"{label:<11} node {node_id}  statusword — no SDO response")
        return False
    fault = bool(sw & 0x0008)
    ok = not fault
    result(ok, f"{label:<11} node {node_id}  statusword 0x{sw:04X} — {'no fault' if ok else _red('FAULT')}")
    return ok

