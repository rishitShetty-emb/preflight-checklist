def _precise_sleep_until(target_ns):
    """Hybrid sleep: OS yield for coarse portion, busy-wait for last 300 µs."""
    while True:
        slack = target_ns - time.monotonic_ns()
        if slack <= 0:
            break
        if slack > 500_000:
            time.sleep(slack / 2e9)

