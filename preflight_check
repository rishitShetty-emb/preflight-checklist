def check_amr():
    print("\n[AMR (can0)]")
    iface = 'can0'

    up = can_interface_up(iface)
    result(up, "Interface UP")
    if not up:
        for nid, name in AMR_NODES.items():
            result(False, f"{name:<11} node {nid}  statusword — skipped (interface down)")
        result(False, "Home offsets — skipped (interface down)")
        return

    try:
        sock = _open_can_socket(iface)
    except Exception as exc:
        for nid, name in AMR_NODES.items():
            result(False, f"{name:<11} node {nid}  statusword — socket error: {exc}")
        result(False, f"Home offsets — socket error: {exc}")
        return

    try:
        send_nmt(sock, NMT_PRE_OP, 0)
        time.sleep(0.1)

        for nid, name in AMR_NODES.items():
            check_statusword_sock(sock, nid, name)

        check_motor_pids(sock, list(AMR_NODES.keys()))

        _run_steering_homing(sock)

        send_nmt(sock, NMT_PRE_OP, 0)
        time.sleep(0.1)

        for nid in sorted(REQUIRED_STEERING_NODES):
            sdo_write_i32(sock, nid, 0x6081, 0, 0)

        run_can_timing_test(sock, 'can0', list(AMR_NODES.keys()),
                            tpdo1_map=AMR_TPDO1, tpdo2_map=AMR_TPDO2)
    finally:
        sock.close()


def _await_statusword(sock, nid, mask, expected, timeout=2.0, label=''):
    """Poll statusword until (sw & mask) == expected. Returns final sw or None on timeout."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        sw = sdo_read_u16(sock, nid, 0x6041, 0)
        if sw is not None and (sw & mask) == expected:
            return sw
        time.sleep(0.02)
    sw = sdo_read_u16(sock, nid, 0x6041, 0)
    print(f"  [warn] node {nid} {label} state timeout  sw=0x{sw:04X}" if sw is not None
          else f"  [warn] node {nid} {label} state timeout  sw=<no response>")
    return None


def _run_steering_homing(sock):
    """Command each steering node to position 0 and verify arrival via CiA 402."""
    _STEER_PROFILE_VEL   = int(1000 * 512 * 92500 / 1875)  # 25 173 333
    _STEER_PROFILE_ACCEL = int(1515.52 * 100)               # 151 552

    print("\n  [Homing steering motors — nodes 2, 4, 6]")
    for nid in sorted(REQUIRED_STEERING_NODES):
        name = AMR_NODES[nid]
        target = 0

        send_nmt(sock, NMT_START, nid)
        time.sleep(0.1)

        sdo_write_i8(sock, nid, 0x6060, 0, 1)

        sdo_write_u16(sock, nid, 0x6040, 0, 0x0080)
        _await_statusword(sock, nid, 0x0008, 0x0000, label='FaultReset')

        sdo_write_u16(sock, nid, 0x6040, 0, 0x0006)
        _await_statusword(sock, nid, 0x006F, 0x0021, label='Ready-to-Switch-On')

        sdo_write_i32(sock, nid, 0x607A, 0, target)
        sdo_write_i32(sock, nid, 0x6081, 0, _STEER_PROFILE_VEL)
        sdo_write_i32(sock, nid, 0x6083, 0, _STEER_PROFILE_ACCEL)
        sdo_write_i32(sock, nid, 0x6084, 0, _STEER_PROFILE_ACCEL)

        sdo_write_u16(sock, nid, 0x6040, 0, 0x103F)

        deadline = time.monotonic() + 30.0
        reached = False
        while time.monotonic() < deadline:
            sw = sdo_read_u16(sock, nid, 0x6041, 0)
            if sw is not None and (sw & 0x0400):
                reached = True
                break
            time.sleep(0.1)

        if not reached:
            result(False, f"{name:<11} node {nid}  homing failed (timeout)")
        else:
            result(True, f"{name:<11} node {nid}  homed")

        sdo_write_u16(sock, nid, 0x6040, 0, 0x0006)
        time.sleep(0.05)
        send_nmt(sock, NMT_PRE_OP, nid)
        time.sleep(0.05)

    try:
        answer = input("\n  Visually confirm: are all steering motors at home position? [y/n]: ").strip().lower()
    except EOFError:
        answer = 'n'
    result(answer == 'y', "Operator confirmed steering motors at home position")

